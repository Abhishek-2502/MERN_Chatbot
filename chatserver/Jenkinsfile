pipeline {
    agent { label 'mern_chatbot' }

    environment {
        BACKEND_ENV_PATH = '/home/ubuntu/chatserver.env' // Update if needed
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out backend source code...'
                checkout scm
            }
        }

        stage('Inject .env') {
            steps {
                echo 'Copying .env into chatserver folder...'
                sh '''
                    cp $BACKEND_ENV_PATH chatserver/.env
                    ls -la chatserver/
                '''
            }
        }

        stage('Pre-Build Cleanup') {
            steps {
                echo 'Cleaning up old backend containers and images...'
                sh '''
                    docker rm -f chatbot-backend-container || true
                    docker image rm chatbot-backend || true
                    docker system prune -f || true
                '''
            }
        }

        stage('Build Backend Docker Image') {
            steps {
                echo 'Building Docker image for backend...'
                dir('chatserver') {
                    sh 'docker build -t chatbot-backend .'
                }
            }
        }

        stage('Run Backend Container') {
            steps {
                echo 'Running backend container...'
                sh '''
                    docker run -d -p 5001:5001 \
                        --env-file chatserver/.env \
                        --name chatbot-backend-container \
                        chatbot-backend
                '''
            }
        }
    }

    post {
        success {
            echo 'Backend deployed successfully.'
            sh 'docker ps --filter name=chatbot-backend-container'
        }
        failure {
            echo 'Backend deployment failed.'
            sh 'docker logs chatbot-backend-container || true'
        }
        always {
            echo 'Displaying all Docker containers...'
            sh 'docker ps -a'
        }
    }
}
